# =============================================================================
# Add these in .env.local (local) AND in your host admin (Vercel → Settings →
# Environment Variables). Never commit real secrets.
# =============================================================================

# Public site URL used for canonical, sitemap, Open Graph and JSON-LD.
# Example: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=

# Optional GA4 measurement ID (e.g. G-XXXXXXXXXX). Safe to leave blank.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Resend contact form (required for /api/contact to send email) ---
# 1. Create account at https://resend.com
# 2. Create an API key → paste below
# 3. Verify a domain (or use onboarding@resend.dev for testing only)
# 4. Set CONTACT_FROM_EMAIL to a verified sender
RESEND_API_KEY=

# Verified sender — examples:
#   Portfolio <onboarding@resend.dev>          (Resend test sender)
#   Pardeep <hello@yourdomain.com>             (after domain verify)
CONTACT_FROM_EMAIL=

# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=pardeepkaushik0508@gmail.com

# IMPORTANT (Resend):
# - Free/test: CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
#   and CONTACT_TO_EMAIL must be the email used to sign up on Resend.
# - Production: verify your domain in Resend, then use e.g.
#   CONTACT_FROM_EMAIL=Pardeep <hello@yourdomain.com>
# - Gmail/Yahoo as FROM will fail unless that domain is verified in Resend.
