# =============================================================================
# Add these in .env.local (local) AND in your host admin (Environment Variables).
# Never commit real secrets / API keys.
# =============================================================================

# Public site URL (canonical, sitemap, Open Graph, JSON-LD) — no trailing slash
NEXT_PUBLIC_SITE_URL=https://pardeepkaushik.info

# Optional GA4 measurement ID (e.g. G-XXXXXXXXXX). Safe to leave blank.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional Search Console / Bing verification meta tags (paste token only, not HTML)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional IndexNow (Bing). Never commit a real key.
# 1) Create key → host public/{KEY}.txt with the key as file contents
# 2) Set INDEXNOW_KEY=your-key
# 3) Set INDEXNOW_SUBMIT_SECRET for POST /api/indexnow auth
INDEXNOW_KEY=
INDEXNOW_SUBMIT_SECRET=

# --- Resend contact form ---
# Domain pardeepkaushik.info is verified in Resend.
RESEND_API_KEY=

# Must use an address on the verified domain (not Gmail)
CONTACT_FROM_EMAIL=Pardeep <hello@pardeepkaushik.info>

# Where form submissions are delivered
CONTACT_TO_EMAIL=pardeepkaushik0508@gmail.com

# Other valid FROM examples (same domain):
#   CONTACT_FROM_EMAIL=Portfolio <noreply@pardeepkaushik.info>
#   CONTACT_FROM_EMAIL=Contact <contact@pardeepkaushik.info>
# Do NOT use Gmail/Yahoo as FROM — Resend will reject them.
