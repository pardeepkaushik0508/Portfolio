# Public site URL used for canonical, sitemap, Open Graph and JSON-LD.
# Example: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=

# Optional GA4 measurement ID (e.g. G-XXXXXXXXXX). Safe to leave blank.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Resend API key (server-only — never expose to the browser)
RESEND_API_KEY=

# Verified sender address in Resend (e.g. Portfolio <onboarding@resend.dev> or your domain)
CONTACT_FROM_EMAIL=

# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=pardeepkaushik0508@gmail.com
